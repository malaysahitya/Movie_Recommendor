# ======================================================
# Movie Recommender Agent — Environment Configuration
# ======================================================

# 1. Google Gemini API Key (Required for Google ADK Agents)
# Get your free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. TMDB API Key (Required for live movie search, ratings, & streaming)
# Get your free key at: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# 3. OMDb API Key (Optional — for additional IMDb scores)
# Get your free key at: http://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_optional

# 4. Application Defaults
DEFAULT_RESULT_LIMIT=10
MIN_YEAR=1950
MAX_YEAR=2026
DATABASE_URL=sqlite+aiosqlite:///./movie_agent.db
