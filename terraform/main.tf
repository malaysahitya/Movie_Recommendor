# Infrastructure as Code (IaC) Terraform Main Entrypoint
# Provisioning Google Cloud Run, Secret Manager, and IAM for Movie Recommender Agent

terraform {
  required_version = ">= 1.5.0"
  required_providers {
    google = {
      source  = "hashicorp/google"
      version = "~> 5.0"
    }
  }
}

provider "google" {
  project = var.gcp_project_id
  region  = var.gcp_region
}
